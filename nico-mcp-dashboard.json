    {
      "id": 15,
      "title": "MCP HTTP requests by status code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 31,
        "w": 6,
        "h": 8
      },
      "targets": [
